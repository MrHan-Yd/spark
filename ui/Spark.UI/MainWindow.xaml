<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Spark.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Spark">

  <!-- 对齐 ui-prototype 主弹窗：深色玻璃感（稳定 Fallback 色，避免 Acrylic 闪退） -->
  <Grid x:Name="Root" Background="#E61C1C1E">
    <Border BorderBrush="#28FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 搜索行 -->
      <Grid Padding="18,16,14,14" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="#8CFFFFFF" VerticalAlignment="Center"/>

        <TextBox x:Name="QueryBox" Grid.Column="1"
                 PlaceholderText="搜索应用、文件、命令…"
                 FontSize="20"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#EBEBEB"
                 PlaceholderForeground="#61FFFFFF"
                 TextChanged="OnQueryChanged"
                 KeyDown="OnQueryKeyDown"/>

        <TextBlock x:Name="SearchMeta" Grid.Column="2" Text="" FontSize="12"
                   Foreground="#61FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>

        <Border Grid.Column="3" Background="#14FFFFFF" CornerRadius="8"
                BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="BtnViewList" Width="28" Height="26" Padding="0"
                    Background="#380A84FF" BorderThickness="0" CornerRadius="6"
                    Click="OnViewList" ToolTipService.ToolTip="列表">
              <FontIcon Glyph="&#xE8FD;" FontSize="12" Foreground="#EBEBEB"/>
            </Button>
            <Button x:Name="BtnViewGrid" Width="28" Height="26" Padding="0"
                    Background="Transparent" BorderThickness="0" CornerRadius="6"
                    Click="OnViewGrid" ToolTipService.ToolTip="平铺">
              <FontIcon Glyph="&#xE8A9;" FontSize="12" Foreground="#61FFFFFF"/>
            </Button>
          </StackPanel>
        </Border>

        <Button Grid.Column="4" Width="32" Height="32" Padding="0"
                Background="Transparent" BorderThickness="0" CornerRadius="8"
                Click="OnOpenSettings" ToolTipService.ToolTip="设置">
          <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#61FFFFFF"/>
        </Button>
      </Grid>

      <Border Grid.Row="1" Height="1" Margin="12,0" Background="#1AFFFFFF"/>

      <!-- 列表 -->
      <ListView x:Name="ResultList" Grid.Row="2" Margin="8,6,8,4" MaxHeight="360"
                SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnItemClick"
                Background="Transparent" BorderThickness="0">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="12"/>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="36" Height="36">
                <Border CornerRadius="9" Background="#14FFFFFF"
                        Visibility="{Binding IconImageVisibility}">
                  <Image Source="{Binding IconImage}" Width="28" Height="28" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border CornerRadius="9" Background="{Binding IconBrush}"
                        Visibility="{Binding IconTextVisibility}">
                  <TextBlock Text="{Binding IconGlyph}" FontSize="13" FontWeight="SemiBold"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                           Foreground="#EBEBEB" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                           Foreground="#8CFFFFFF" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding SourceLabel}" FontSize="11"
                         Foreground="#61FFFFFF" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <!-- 平铺（简单 Uniform 网格，避免 ItemsWrapGrid 问题） -->
      <GridView x:Name="ResultGrid" Grid.Row="2" Margin="8,6,8,4" MaxHeight="360"
                SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnItemClick"
                Background="Transparent" BorderThickness="0" Visibility="Collapsed">
        <GridView.ItemContainerStyle>
          <Style TargetType="GridViewItem">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="114"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <Grid Width="48" Height="48" HorizontalAlignment="Center">
                <Border CornerRadius="12" Background="#14FFFFFF"
                        Visibility="{Binding IconImageVisibility}">
                  <Image Source="{Binding IconImage}" Width="40" Height="40" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border CornerRadius="12" Background="{Binding IconBrush}"
                        Visibility="{Binding IconTextVisibility}">
                  <TextBlock Text="{Binding IconGlyph}" FontSize="16" FontWeight="SemiBold"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                         Foreground="#EBEBEB" TextAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SourceLabel}" FontSize="10"
                         Foreground="#61FFFFFF" HorizontalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <!-- 收藏 -->
      <Border Grid.Row="3" Background="#24000000" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0"
              Padding="12,8,12,10">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="#FFD60A"/>
            <TextBlock Text="收藏" FontSize="11" FontWeight="SemiBold" Foreground="#61FFFFFF"/>
            <TextBlock x:Name="FavCount" Text="" FontSize="11" Foreground="#61FFFFFF"/>
          </StackPanel>
          <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Disabled">
            <StackPanel x:Name="FavIcons" Orientation="Horizontal" Spacing="6" MinHeight="56"/>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- 底栏 -->
      <Grid Grid.Row="4" Padding="14,8,14,10" Background="#1F000000"
            BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Background="#14FFFFFF" CornerRadius="6" Padding="8,3">
            <TextBlock Text="Enter 打开" FontSize="11" Foreground="#8CFFFFFF"/>
          </Border>
          <Border Background="#14FFFFFF" CornerRadius="6" Padding="8,3">
            <TextBlock Text="↑↓ 选择" FontSize="11" Foreground="#8CFFFFFF"/>
          </Border>
          <Border Background="#14FFFFFF" CornerRadius="6" Padding="8,3">
            <TextBlock Text="Esc 关闭" FontSize="11" Foreground="#8CFFFFFF"/>
          </Border>
        </StackPanel>
        <TextBlock x:Name="Footer" Text="本地 · 极速" FontSize="11" Foreground="#61FFFFFF"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Grid>

    <!-- 设置 -->
    <Grid x:Name="SettingsPanel" Visibility="Collapsed" Background="#F21C1C1E">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Padding="14,12" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
        <Button Content="← 返回" Click="OnCloseSettings" Background="#14FFFFFF"
                BorderThickness="0" CornerRadius="8" Padding="10,6" FontSize="13"
                Foreground="#8CFFFFFF" HorizontalAlignment="Left"/>
        <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" Foreground="#EBEBEB"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ScrollViewer Grid.Row="1" Padding="20,16">
        <StackPanel Spacing="8" MaxWidth="480">
          <TextBlock Text="热键由 Host 注册（默认 Alt+Space）。" FontSize="13"
                     Foreground="#8CFFFFFF" TextWrapping="Wrap"/>
          <TextBlock x:Name="AboutText" Text="Spark UI" FontSize="13"
                     Foreground="#8CFFFFFF" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
