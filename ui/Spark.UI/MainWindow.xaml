<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Spark.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Spark">

    <!-- 无系统标题栏：内容自绘；圆角/阴影由系统与 Presenter 控制 -->
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16,20,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" PlaceholderText="搜索应用、文件、命令…" FontSize="18"
                     TextChanged="OnQueryChanged" KeyDown="OnQueryKeyDown"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Content="列表" Click="OnList" Padding="10,6"/>
                <Button Content="平铺" Click="OnGrid" Padding="10,6"/>
            </StackPanel>
            <Button Grid.Column="2" Content="设置" Click="OnOpenSettings" Padding="12,8"/>
        </Grid>

        <ListView x:Name="ResultList" Grid.Row="1" Margin="0,12,0,0"
                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnItemClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="8,10" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <GridView x:Name="ResultGrid" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed"
                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnItemClick">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Border Width="120" Padding="12" Margin="4">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Icon}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" TextAlignment="Center" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- settings as second full panel -->
        <Border x:Name="SettingsPanel" Grid.RowSpan="4" Visibility="Collapsed" Padding="16"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="← 返回" Click="OnBack"/>
                    <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <ToggleSwitch x:Name="SwStartup" Header="开机启动" IsOn="True"/>
                <ToggleSwitch x:Name="SwHideFocus" Header="失焦时隐藏" IsOn="True"/>
                <TextBlock Text="热键：Alt+Space（Host 注册后生效）" Opacity="0.7" TextWrapping="Wrap"/>
                <TextBlock Text="托盘由 spark-host 负责。" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="★ 收藏" VerticalAlignment="Center" Opacity="0.7"/>
            <StackPanel x:Name="FavItems" Orientation="Horizontal" Spacing="6"/>
        </StackPanel>

        <TextBlock x:Name="Footer" Grid.Row="3" Margin="0,8,0,0" FontSize="12" Opacity="0.6"
                   Text="Enter 打开 · 离线演示"/>
    </Grid>
</Window>
