<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Spark.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Spark.UI"
    xmlns:models="using:Spark.UI.Models"
    Title="Spark">

  <!-- 对齐 ui-prototype 主弹窗：颜色收成 Root.Resources 画刷，主题切换由代码改 Color（深/浅/跟随系统） -->
  <!-- 圆角：DWM 按系统设置裁窗口圆角（默认 ~8px，实测本机约 5px，不能按窗口单独调大；DeviceCornerRadius=On 时更大）。
       WinCornerRadius 必须与 DWM 弧线重合：XAML 圆角比 DWM 大（或小）时，两弧之间的楔形区会露出
       Root 底色——这就是四角的"贴片"。圆角外的楔形区属于窗口外、显示桌面背景 -->
  <!-- 背景：系统 Acrylic 真玻璃（DWM 模糊 + 半透明 tint，透出桌面壁纸，macOS vibrancy 同构）。
       Root 背景透明；系统禁用透明效果/环境不支持时回退纯色（ApplyTheme 里赋 _windowBg）。 -->
  <Grid x:ConnectionId='2' x:Name="Root">
    <Grid.Resources>
      <!-- 主题画刷（值取自 ui-prototype/styles.css 变量，alpha 已转 ARGB） -->
      <SolidColorBrush x:Key="GlassBorderBrush" Color="#24FFFFFF"/>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EBEBEB"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8CFFFFFF"/>
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#61FFFFFF"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF"/>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#380A84FF"/>
      <SolidColorBrush x:Key="DangerBrush" Color="#FFFF453A"/>
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#38FF453A"/>
      <SolidColorBrush x:Key="DangerBorderBrush" Color="#59FF453A"/>
      <SolidColorBrush x:Key="RowHoverBrush" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="RowActiveBrush" Color="#470A84FF"/>
      <SolidColorBrush x:Key="RowActiveStrongBrush" Color="#5C0A84FF"/>
      <SolidColorBrush x:Key="DividerBrush" Color="#1AFFFFFF"/>
      <SolidColorBrush x:Key="ChipBgBrush" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="FavBgBrush" Color="#24000000"/>
      <SolidColorBrush x:Key="FooterBgBrush" Color="#1F000000"/>
      <SolidColorBrush x:Key="GridTileBgBrush" Color="#08FFFFFF"/>
      <!-- 平铺选中框（中性灰，比平时卡片底明显）：深色 12% 白底 + 25% 白边 -->
      <SolidColorBrush x:Key="GridTileSelBgBrush" Color="#1EFFFFFF"/>
      <SolidColorBrush x:Key="GridTileSelBorderBrush" Color="#40FFFFFF"/>
      <SolidColorBrush x:Key="SwitchTrackOffBrush" Color="#52787880"/>
      <SolidColorBrush x:Key="StarBrush" Color="#FFD60A"/>
      <!-- 顶部高光（对应 .launcher-glass::before） -->
      <LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#14FFFFFF"/>
        <GradientStop Offset="0.28" Color="#00FFFFFF"/>
      </LinearGradientBrush>
      <!-- 收藏卡片模板：无状态模板，杜绝 Button 默认主题在悬停/按下时注入边框/底色；
           选中态完全由代码控制（与结果列表一致的 RowActive/RowHover 画刷，默认无边框） -->
      <ControlTemplate x:Key="FavCardTemplate" TargetType="Button">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="12">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
      <!-- 窗口圆角：与 DWM 实际裁剪半径一致（见文件头注释），ContentClip/高光/描边三处共用 -->
      <CornerRadius x:Key="WinCornerRadius">5</CornerRadius>
      <!-- 模态卡片底（新建分组/删除确认）：深色近黑、浅色近白，由 ApplyTheme 切换 -->
      <SolidColorBrush x:Key="ModalCardBrush" Color="#F21C1C1E"/>

      <!-- 列表/平铺选中态：对齐 .result-item.active（accent-soft 圆角蓝） -->
      <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#470A84FF"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#5C0A84FF"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#5C0A84FF"/>
      <SolidColorBrush x:Key="ListViewItemBorderBrushPointerOver" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="ListViewItemBorderBrushPressed" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="ListViewItemBorderBrushSelected" Color="#470A84FF"/>
      <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#470A84FF"/>
      <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#5C0A84FF"/>
      <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#5C0A84FF"/>
      <SolidColorBrush x:Key="GridViewItemBorderBrushPointerOver" Color="#1AFFFFFF"/>
      <SolidColorBrush x:Key="GridViewItemBorderBrushSelected" Color="#590A84FF"/>
      <SolidColorBrush x:Key="GridViewItemBorderBrushSelectedPointerOver" Color="#590A84FF"/>

      <!-- 搜索框聚焦态保持透明（默认模板 Focused 状态会覆盖 XAML 里的 Background=Transparent，浅色主题下变白底） -->
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>

      <!-- 设置页通用样式 -->
      <Style x:Key="NavItemStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
      </Style>

      <!-- 下拉弹出层基底：半透明玻璃（透出壁纸色斑，别太黑）；深/浅色由 ApplyTheme 切换 -->
      <SolidColorBrush x:Key="ComboPopupBgBrush" Color="#C01C1C1E"/>

      <!-- 设置页下拉框：整模板自绘对齐 chip 玻璃风。
           只设属性不够——默认模板的悬停/按下会用系统灰底覆盖样式、弹出层是不透明系统列表
           （方角、灰色 hover、白色选中、字号不继承），与整体不搭。
           命名部件与默认模板保持一致（LayoutRoot/Background/ContentPresenter/DropDownGlyph/
           Popup/PopupBorder/ScrollViewer/ItemsPresenter）：ComboBox 代码按名取部件，
           弹出层子结构必须是 Popup > Border(PopupBorder) > ScrollViewer > ItemsPresenter，
           PopupBorder.Margin.Top 会被并入弹出位置偏移（0,4 = 闭合框下方留 4px 缝） -->
      <Style x:Key="ComboStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ChipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MaxDropDownHeight" Value="280"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItemStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto"/>
        <Setter Property="ScrollViewer.IsVerticalRailEnabled" Value="True"/>
        <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid x:Name="LayoutRoot">
                <Grid.Resources>
                  <!-- 代码按 key 从 LayoutRoot.Resources 取这两个 Storyboard 做遮罩淡入/淡出（缺了只是无过渡）；
                       硬编码时长避免依赖主题资源 -->
                  <Storyboard x:Key="OverlayOpeningAnimation">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                      <SplineDoubleKeyFrame KeyTime="0:0:0.167" KeySpline="0.33,0,0.67,1" Value="1"/>
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                  <Storyboard x:Key="OverlayClosingAnimation">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                      <SplineDoubleKeyFrame KeyTime="0:0:0.083" KeySpline="0.33,0,0.67,1" Value="0"/>
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </Grid.Resources>
                <VisualStateManager.VisualStateGroups>
                  <!-- 悬停/按下对齐 chip 交互（RowHover 提亮、AccentSoft 按压），不画系统灰底 -->
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="Background.Background" Value="{StaticResource RowHoverBrush}"/>
                        <Setter Target="Background.BorderBrush" Value="{StaticResource GridTileSelBorderBrush}"/>
                        <Setter Target="DropDownGlyph.Stroke" Value="{StaticResource TextPrimaryBrush}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="Background.Background" Value="{StaticResource AccentSoftBrush}"/>
                        <Setter Target="DropDownGlyph.Stroke" Value="{StaticResource TextPrimaryBrush}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters>
                        <Setter Target="Background.Opacity" Value="0.5"/>
                        <Setter Target="DropDownGlyph.Opacity" Value="0.5"/>
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <!-- 聚焦不画系统高亮胶囊（默认 Focused 会叠 HighlightBackground/Pill），保持 chip 原样；
                       键盘焦点圈由 Background 上 Control.IsTemplateFocusTarget 的系统焦点视觉提供 -->
                  <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused"/>
                    <VisualState x:Name="FocusedPressed"/>
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                    <VisualState x:Name="FocusedDropDown">
                      <VisualState.Setters>
                        <Setter Target="PopupBorder.Visibility" Value="Visible"/>
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="DropDownStates">
                    <VisualState x:Name="Opened">
                      <Storyboard>
                        <SplitOpenThemeAnimation OpenedTargetName="PopupBorder"
                            ClosedTargetName="ContentPresenter"
                            OffsetFromCenter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.DropDownOffset}"
                            OpenedLength="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.DropDownOpenedHeight}"/>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Closed">
                      <Storyboard>
                        <SplitCloseThemeAnimation OpenedTargetName="PopupBorder"
                            ClosedTargetName="ContentPresenter"
                            OffsetFromCenter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.DropDownOffset}"
                            OpenedLength="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.DropDownOpenedHeight}"/>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Border x:Name="Background" Control.IsTemplateFocusTarget="True"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <!-- 选中项由 ComboBox 代码直接塞进 ContentPresenter.Content（SelectionBoxItem），模板不绑 Content -->
                    <ContentPresenter x:Name="ContentPresenter"
                                      Foreground="{TemplateBinding Foreground}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                      <TextBlock x:Name="PlaceholderTextBlock" Text="{TemplateBinding PlaceholderText}"
                                 Foreground="{StaticResource TextTertiaryBrush}"/>
                    </ContentPresenter>
                    <!-- 描边箭头（对齐设置页其他图标风格） -->
                    <Path x:Name="DropDownGlyph" Grid.Column="1"
                          Data="M 3 5.5 L 8 10.5 L 13 5.5"
                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Right"
                          Margin="0,0,11,0" IsHitTestVisible="False"
                          AutomationProperties.AccessibilityView="Raw"/>
                  </Grid>
                </Border>

                <Popup x:Name="Popup">
                  <!-- Margin.Top 会被控件代码并入弹出层垂直偏移（ArrangePopup 里 verticalOffset = popupTop + borderMargin.Top）。
                       保持小值：弹出层维持默认"选中项对齐选择框中心"的布局 -->
                  <Border x:Name="PopupBorder"
                          Background="{StaticResource ComboPopupBgBrush}" BackgroundSizing="InnerBorderEdge"
                          BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                          CornerRadius="8" Margin="0,4,0,0" Padding="4"
                          HorizontalAlignment="Stretch">
                    <ScrollViewer x:Name="ScrollViewer"
                                  MinWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.DropDownContentMinWidth}"
                                  VerticalSnapPointsType="OptionalSingle" VerticalSnapPointsAlignment="Near"
                                  HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                                  IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                                  IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                  BringIntoViewOnFocusChange="{TemplateBinding ScrollViewer.BringIntoViewOnFocusChange}"
                                  ZoomMode="Disabled"
                                  AutomationProperties.AccessibilityView="Raw">
                      <ItemsPresenter x:Name="ItemsPresenter"/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 下拉项：悬停/选中对齐结果列表（RowHover 提亮、RowActive accent-soft 圆角底）。
           Popup 是独立窗口根，字号/前景不继承 ComboBox，需显式定 -->
      <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
              <Grid x:Name="LayoutRoot" Margin="0,1" CornerRadius="{TemplateBinding CornerRadius}"
                    Background="{TemplateBinding Background}" Control.IsTemplateFocusTarget="True">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{StaticResource RowHoverBrush}"/>
                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{StaticResource RowActiveBrush}"/>
                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Opacity" Value="0.5"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{StaticResource RowActiveBrush}"/>
                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SelectedUnfocused">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{StaticResource RowActiveBrush}"/>
                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SelectedDisabled">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Opacity" Value="0.5"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SelectedPointerOver">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{StaticResource RowActiveStrongBrush}"/>
                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SelectedPressed">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{StaticResource RowActiveStrongBrush}"/>
                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="InputModeStates">
                    <VisualState x:Name="InputModeDefault"/>
                    <VisualState x:Name="TouchInputMode"/>
                    <VisualState x:Name="GameControllerInputMode"/>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Margin="{TemplateBinding Padding}"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="PresetStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ChipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
      </Style>

      <Style x:Key="PaneRowBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,13"/>
      </Style>

      <!-- 原型 .switch（42x26 胶囊 + 滑块）。
           不用 ToggleSwitch：自定义模板后其点击切换与 IsOn 视觉状态都会失效（控件代码依赖默认模板的
           SwitchAreaGrid/SwitchKnob 等命名元素，缺失时状态机制整个不工作）。
           视觉由代码驱动（AnimateSwitchToggle）：切换时 200ms 滑块滑动 + 轨道颜色渐变（对齐原型 transition 0.2s）；
           不用模板内 CheckStates VSM（实测状态切换不稳定）。 -->
      <Style x:Key="SwitchStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Grid Width="42" Height="26" Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"/>
                    <VisualState x:Name="Pressed"/>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters>
                        <Setter Target="Track.Opacity" Value="0.5"/>
                        <Setter Target="Thumb.Opacity" Value="0.5"/>
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <!-- OFF 轨道 = 共享主题刷 SwitchTrackOffBrush（ApplyTheme 按深浅主题原地改色，
                     浅色主题下 20% 黑清晰可见，主题切换时所有 OFF 轨道实时跟随）。
                     它被全部开关实例共享，绝不能原地改 Color：AnimateSwitchToggle 动画走私有克隆刷 -->
                <Border x:Name="Track" CornerRadius="13" Background="{StaticResource SwitchTrackOffBrush}"/>
                <!-- 滑块：白底 + 细描边模拟原型 box-shadow 的立体感 -->
                <Border x:Name="Thumb" Width="22" Height="22" CornerRadius="11" Background="White"
                        BorderBrush="#33000000" BorderThickness="1"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2">
                  <Border.RenderTransform>
                    <TranslateTransform x:Name="ThumbTransform"/>
                  </Border.RenderTransform>
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ===== 市场列表模板（分类分组用，规范 §3.3 tags）=====
           列表保持扁平 ItemsSource：分组头是插进数据源的一行，由 MarketRowSelector
           按行类型派发模板。不用 CollectionViewSource.IsSourceGrouped 是因为市场列表
           依赖"筛选结果逐项一致时不重赋 ItemsSource"，换分组源会打断安装中卡片的
           进度动画与滚动位置。 -->
      <DataTemplate x:Key="MarketGroupHeaderTemplate">
        <Grid Margin="2,6,0,10" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding HeaderText}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Height="1" Background="{StaticResource GlassBorderBrush}"
                  VerticalAlignment="Center"/>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="MarketCardTemplate">
        <Border Background="{StaticResource ChipBgBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,8">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 图标：远程加载的 Image 优先，失败/未就绪退回首字母兜底 -->
            <Grid Width="34" Height="34" VerticalAlignment="Center">
              <Image Source="{Binding IconImage}" Stretch="Uniform"
                     Visibility="{Binding IconImageVisibility}"/>
              <Border CornerRadius="9" Background="{StaticResource ChipBgBrush}"
                      Visibility="{Binding IconLetterVisibility}">
                <TextBlock Text="{Binding IconLetter}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>

            <!-- 名称 + 版本 + 角标 + 描述 + 元信息 -->
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock Text="{Binding VersionText}" FontSize="10" VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}"/>
                <Border Background="#33FF9F0A" CornerRadius="4" Padding="5,1"
                        Visibility="{Binding NativeBadgeVisibility}" VerticalAlignment="Center">
                  <TextBlock Text="原生" FontSize="9" Foreground="#FFFF9F0A"/>
                </Border>
                <!-- 签名角标（规范 Phase 4.3/4.4）：官方源按索引 signature.key_id 预判"官方"（下载前展示）；
                     已装副本本地验签优先（包内权威）；官方源未签名版本显灰"待签名"；三方源仅本地验签通过后显示 -->
                <Border Background="{Binding SignBadgeBackground}" CornerRadius="4" Padding="5,1"
                        Visibility="{Binding SignBadgeVisibility}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SignBadgeText}" FontSize="9"
                             Foreground="{Binding SignBadgeForeground}"/>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Description}" FontSize="11"
                         Foreground="{StaticResource TextTertiaryBrush}"
                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" LineHeight="16"/>
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="4"
                            Visibility="{Binding AuthorVisibility}">
                  <FontIcon Glyph="&#xE77B;" FontSize="10"
                            Foreground="{StaticResource TextTertiaryBrush}"/>
                  <TextBlock Text="{Binding Author}" FontSize="10"
                             Foreground="{StaticResource TextTertiaryBrush}"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <FontIcon Glyph="&#xE8D7;" FontSize="10"
                            Foreground="{StaticResource TextTertiaryBrush}"/>
                  <TextBlock Text="{Binding PermissionsSummary}" FontSize="10"
                             Foreground="{StaticResource TextTertiaryBrush}"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- 分类标签：让用户看清这张卡片是从哪个分类检索出来的（多标签取前 3 个） -->
                <StackPanel Orientation="Horizontal" Spacing="4"
                            Visibility="{Binding TagsVisibility}">
                  <FontIcon Glyph="&#xE8EC;" FontSize="10"
                            Foreground="{StaticResource TextTertiaryBrush}"/>
                  <TextBlock Text="{Binding TagsSummary}" FontSize="10"
                             Foreground="{StaticResource TextTertiaryBrush}"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- 右侧：安装/更新按钮（版本号在名称行展示）。安装中按钮自身即进度载体：
                 水体从底部升起 + 双层正弦波横流（充电动画式），满格=下载完成 -->
            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
              <Button x:ConnectionId='4' Content="{Binding ActionButtonText}" IsEnabled="{Binding ActionButtonEnabled}"
                                                       Padding="12,5" CornerRadius="8"
                                                                                       
                                                                            
                      FontSize="11" FontWeight="SemiBold" BorderThickness="0"
                      Background="{StaticResource AccentSoftBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Grid x:Name="WaveRoot">
                      <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                          <VisualState x:Name="Normal"/>
                          <VisualState x:Name="PointerOver">
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="WaveRoot" Storyboard.TargetProperty="Opacity"
                                               To="0.88" Duration="0"/>
                            </Storyboard>
                          </VisualState>
                          <VisualState x:Name="Pressed">
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="WaveRoot" Storyboard.TargetProperty="Opacity"
                                               To="0.75" Duration="0"/>
                            </Storyboard>
                          </VisualState>
                          <VisualState x:Name="Disabled">
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="WaveRoot" Storyboard.TargetProperty="Opacity"
                                               To="0.45" Duration="0"/>
                            </Storyboard>
                          </VisualState>
                        </VisualStateGroup>
                      </VisualStateManager.VisualStateGroups>
                      <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
                      <!-- 水体：显式 Width=0 + Left 对齐，使其对按钮期望尺寸的贡献恒为 0
                           （Canvas/Grid 的可见子元素本会计入 DesiredSize，撑宽按钮）；
                           波浪向右渲染、超出部分由 WaveRoot 的 Clip（代码设置）裁齐。
                           Height 由代码随下载进度驱动。 -->
                      <Canvas x:Name="WaveWater" Width="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="0"
                              Visibility="Collapsed" IsHitTestVisible="False">
                        <Path x:Name="WaveBack" Canvas.Left="0" Canvas.Top="0" Margin="-12,1.5,0,0"
                              Fill="#244C9AFF"
                              Data="M0,2.5 Q6,-1 12,2.5 T24,2.5 T36,2.5 T48,2.5 T60,2.5 T72,2.5 T84,2.5 T96,2.5 T108,2.5 T120,2.5 T132,2.5 T144,2.5 T156,2.5 T168,2.5 T180,2.5 T192,2.5 T204,2.5 T216,2.5 T228,2.5 T240,2.5 T252,2.5 T264,2.5 L264,44 L0,44 Z"/>
                        <Path x:Name="WaveFront" Canvas.Left="0" Canvas.Top="0"
                              Fill="#3D4C9AFF"
                              Data="M0,2.5 Q6,-1 12,2.5 T24,2.5 T36,2.5 T48,2.5 T60,2.5 T72,2.5 T84,2.5 T96,2.5 T108,2.5 T120,2.5 T132,2.5 T144,2.5 T156,2.5 T168,2.5 T180,2.5 T192,2.5 T204,2.5 T216,2.5 T228,2.5 T240,2.5 T252,2.5 T264,2.5 L264,44 L0,44 Z"/>
                      </Canvas>
                      <ContentPresenter Content="{TemplateBinding Content}"
                                        Foreground="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}"/>
                    </Grid>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <models:MarketRowTemplateSelector x:Key="MarketRowSelector"
                                        HeaderTemplate="{StaticResource MarketGroupHeaderTemplate}"
                                        CardTemplate="{StaticResource MarketCardTemplate}"/>
    </Grid.Resources>

    <!-- ========== 内容层：CornerRadius = WinCornerRadius，与 DWM 弧线重合 ==========
         背景由系统 Acrylic 提供（DWM 裁圆角），这里不再画任何壁纸/色斑；
         圆角外的楔形区没有任何内容，属于窗口外、显示桌面背景 -->
    <Grid x:ConnectionId='69' x:Name="ContentClip" CornerRadius="{StaticResource WinCornerRadius}">

    <!-- ========== 搜索模式 ========== -->
    <Grid x:ConnectionId='70' x:Name="MainPanel" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <!-- 模式切换过渡：主页左滑淡出 / 从左滑入（对齐原型 mode-leave-left / mode-enter-from-left） -->
        <TransformGroup>
          <TranslateTransform x:ConnectionId='197' x:Name="MainShift"/>
          <ScaleTransform x:ConnectionId='198' x:Name="MainScale"/>
        </TransformGroup>
      </Grid.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 搜索行（对齐原型 .search-row：padding 16/18/14，gap 12） -->
      <Grid Padding="18,16,18,14" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 放大镜（原型 SVG 描边风格）。几何是 24×24 viewBox 坐标系，必须 Stretch=Uniform 缩进 20×20，
             否则手柄末端 (21,21) 超出尺寸被裁剪（右下角缺一截） -->
        <Path Data="M 11 4 A 7 7 0 1 0 11 18 A 7 7 0 1 0 11 4 M 16.5 16.5 L 21 21"
              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20"
              Stretch="Uniform" VerticalAlignment="Center"/>

        <TextBox x:ConnectionId='233' x:Name="QueryBox" Grid.Column="1"
                 PlaceholderText="搜索应用、文件、命令…"
                 FontSize="20"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 PlaceholderForeground="{StaticResource TextTertiaryBrush}"
                                             
                                         />

        <TextBlock x:ConnectionId='234' x:Name="SearchMeta" Grid.Column="2" Text="" FontSize="12"
                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>

        <!-- 视图切换（原型 .view-toggle：chip 底 + 边框） -->
        <Border Grid.Column="3" Background="{StaticResource ChipBgBrush}" CornerRadius="8"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:ConnectionId='236' x:Name="BtnViewList" Width="28" Height="26" Padding="0"
                    Background="{StaticResource AccentSoftBrush}" BorderThickness="0" CornerRadius="6"
                                       ToolTipService.ToolTip="列表视图">
              <Path Data="M 2 3.9 H 14 M 2 8 H 14 M 2 12.1 H 14"
                    Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="16" Height="16"/>
            </Button>
            <Button x:ConnectionId='237' x:Name="BtnViewGrid" Width="28" Height="26" Padding="0"
                    Background="Transparent" BorderThickness="0" CornerRadius="6"
                                       ToolTipService.ToolTip="平铺视图">
              <Path Data="M 2 2 H 7 V 7 H 2 Z M 9 2 H 14 V 7 H 9 Z M 2 9 H 7 V 14 H 2 Z M 9 9 H 14 V 14 H 9 Z"
                    Fill="{StaticResource TextTertiaryBrush}" Width="16" Height="16"/>
            </Button>
          </StackPanel>
        </Border>

        <!-- 设置按钮（原型 .icon-tool 32x32）。齿轮几何是 24×24 viewBox 坐标系，必须 Stretch=Uniform 缩进 18×18，
             否则右侧 (x20-22)、底部 (y20-22)、右下辐条超出尺寸被裁剪（图标画不全） -->
        <Button x:ConnectionId='235' Grid.Column="4" x:Name="BtnSettings" Width="32" Height="32" Padding="0"
                Background="Transparent" BorderThickness="0" CornerRadius="8"
                                       ToolTipService.ToolTip="设置 (Ctrl+,)">
          <Path Data="M 12 2 V 4 M 12 20 V 22 M 4.93 4.93 L 6.34 6.34 M 17.66 17.66 L 19.07 19.07 M 2 12 H 4 M 20 12 H 22 M 4.93 19.07 L 6.34 17.66 M 17.66 6.34 L 19.07 4.93 M 9 12 A 3 3 0 1 0 15 12 A 3 3 0 1 0 9 12"
                Stroke="{StaticResource TextTertiaryBrush}" StrokeThickness="1.7"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Width="18" Height="18" Stretch="Uniform"/>
        </Button>
      </Grid>

      <!-- 分隔线（原型 .divider） -->
      <Border Grid.Row="1" Height="1" Margin="12,0" Background="{StaticResource DividerBrush}"/>

      <!-- 列表 -->
      <ListView x:ConnectionId='199' x:Name="ResultList" Grid.Row="2" Margin="8,6,8,4"
                SelectionMode="Single" IsItemClickEnabled="True"                        
                Background="Transparent" BorderThickness="0">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="12"/>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="36" Height="36">
                <!-- 图标直接裸露（同收藏页：无圆角底衬，避免图片外圈露浅灰边框） -->
                <Image Source="{Binding IconImage}" Width="36" Height="36" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IconImageVisibility}"/>
                <Border CornerRadius="9" Background="{Binding IconBrush}"
                        Visibility="{Binding IconTextVisibility}">
                  <TextBlock Text="{Binding IconGlyph}" FontFamily="{Binding IconFont}" FontSize="{Binding IconFontSize}" FontWeight="Medium"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:ConnectionId='232' x:Name="RowTitle" FontSize="14" FontWeight="Medium"
                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                                         />
                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding SourceLabel}" FontSize="11"
                         Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <!-- 平铺（对齐原型 .fav-item：80px 小方卡 + 40 icon，一行 9 个）
           默认模板的 ListViewItemPresenter 圆角只认主题资源 GridViewItemCornerRadius（=4），
           样式里的 CornerRadius 不生效；这里自定义模板用 Border 画圆角卡（12）。
           平时卡片透明不可见，只有选中（光标处）才显示 accent 圆角框，当作选中指示器 -->
      <GridView x:ConnectionId='200' x:Name="ResultGrid" Grid.Row="2" Margin="8,6,8,4"
                SelectionMode="Single" IsItemClickEnabled="True"                        
                Background="Transparent" BorderThickness="0" Visibility="Collapsed">
        <GridView.ItemContainerStyle>
          <Style TargetType="GridViewItem">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="4,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                  <Grid>
                    <VisualStateManager.VisualStateGroups>
                      <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                          <VisualState.Setters>
                            <Setter Target="Card.Background" Value="{StaticResource RowHoverBrush}"/>
                            <Setter Target="Card.BorderBrush" Value="{StaticResource DividerBrush}"/>
                          </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                          <VisualState.Setters>
                            <Setter Target="CardScale.ScaleX" Value="0.96"/>
                            <Setter Target="CardScale.ScaleY" Value="0.96"/>
                          </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Selected">
                          <VisualState.Setters>
                            <Setter Target="Card.Background" Value="{StaticResource GridTileSelBgBrush}"/>
                            <Setter Target="Card.BorderBrush" Value="{StaticResource GridTileSelBorderBrush}"/>
                          </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOverSelected">
                          <VisualState.Setters>
                            <Setter Target="Card.Background" Value="{StaticResource GridTileSelBgBrush}"/>
                            <Setter Target="Card.BorderBrush" Value="{StaticResource GridTileSelBorderBrush}"/>
                          </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PressedSelected">
                          <VisualState.Setters>
                            <Setter Target="Card.Background" Value="{StaticResource GridTileSelBgBrush}"/>
                            <Setter Target="Card.BorderBrush" Value="{StaticResource GridTileSelBorderBrush}"/>
                          </VisualState.Setters>
                        </VisualState>
                      </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="Card"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="12"
                            RenderTransformOrigin="0.5,0.5">
                      <Border.RenderTransform>
                        <ScaleTransform x:Name="CardScale"/>
                      </Border.RenderTransform>
                      <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Margin="{TemplateBinding Padding}"/>
                    </Border>
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
              <!-- 图标直接裸露（同收藏：无圆角底容器）；无图标时回退彩色字卡 -->
              <Grid Width="40" Height="40" HorizontalAlignment="Center">
                <Image Source="{Binding IconImage}" Width="36" Height="36" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IconImageVisibility}"/>
                <Border Width="36" Height="36" CornerRadius="10" Background="{Binding IconBrush}"
                        Visibility="{Binding IconTextVisibility}">
                  <TextBlock Text="{Binding IconGlyph}" FontFamily="{Binding IconFont}" FontSize="{Binding IconFontSize}" FontWeight="SemiBold"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
              <TextBlock x:ConnectionId='230' x:Name="TileTitle" FontSize="10"
                         Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxLines="1"
                                                                       />
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <!-- 空状态提示：搜索无结果 / 无最近使用时居中展示，避免页面空洞 -->
      <TextBlock x:ConnectionId='201' x:Name="EmptyState" Grid.Row="2" Text="" FontSize="14"
                 Foreground="{StaticResource TextTertiaryBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" MaxLines="1"
                 IsHitTestVisible="False"/>

      <!-- 收藏坞（对齐原型 .favorites：折叠 + 分组 tab + 72px 卡片） -->
      <Border Grid.Row="3" Background="{StaticResource FavBgBrush}"
              BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
              Padding="12,6,12,8">
        <StackPanel x:ConnectionId='204' x:Name="FavRoot" Spacing="8">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition x:ConnectionId='210' x:Name="FavGroupsCol" Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:ConnectionId='211' x:Name="FavToggle" Background="Transparent" BorderThickness="0"
                    Padding="2,4,6,4" CornerRadius="8"                     ToolTipService.ToolTip="收起收藏">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path x:ConnectionId='214' x:Name="FavChevronPath" Data="M 4.5 6.2 L 8 9.7 L 11.5 6.2"
                      Stroke="{StaticResource TextTertiaryBrush}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12"
                      Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <Path.RenderTransform>
                    <TransformGroup>
                      <TranslateTransform x:ConnectionId='216' x:Name="FavChevronShift"/>
                      <RotateTransform x:ConnectionId='217' x:Name="FavChevronRotate"/>
                    </TransformGroup>
                  </Path.RenderTransform>
                </Path>
                <Path Data="M 8 1.5 L 9.76 5.07 L 13.7 5.64 L 10.85 8.42 L 11.52 12.34 L 8 10.5 L 4.48 12.34 L 5.15 8.42 L 2.3 5.64 L 6.24 5.07 Z"
                      Fill="{StaticResource StarBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="收藏" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                <TextBlock x:ConnectionId='215' x:Name="FavCount" Text="" FontSize="11"
                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <ScrollViewer Grid.Column="1" HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
              <StackPanel x:ConnectionId='213' x:Name="FavGroups" Orientation="Horizontal" Spacing="4" Padding="0,2"/>
            </ScrollViewer>

            <Button x:ConnectionId='212' x:Name="FavAddGroup" Grid.Column="2" Width="22" Height="22" Padding="0"
                    Background="Transparent"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="6"
                                          ToolTipService.ToolTip="新建分组" VerticalAlignment="Center"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
              <!-- 加号用 Path 而非文本 "+"：文本有基线/字面上下留白，小按钮里视觉偏移；路径几何精确居中 -->
              <Path Data="M 6 2 L 6 10 M 2 6 L 10 6" Width="12" Height="12" Stretch="Uniform"
                    Stroke="{StaticResource TextTertiaryBrush}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
          </Grid>

          <!-- 展开/收起只动外层 Border 高度 + 裁剪框：Clip 是视觉属性不触发布局，
               内容层（ScrollViewer）固定自然高度，不再每帧重测 → 动画流畅 -->
          <Border x:ConnectionId='205' x:Name="FavBodyClip">
            <Border.Clip>
              <RectangleGeometry x:ConnectionId='206' x:Name="FavBodyClipRect"/>
            </Border.Clip>
            <ScrollViewer x:ConnectionId='207' x:Name="FavBody" HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                          VerticalAlignment="Top">
              <StackPanel x:ConnectionId='208' x:Name="FavItems" Orientation="Horizontal" Spacing="6"
                          MinHeight="64" Padding="0,0,0,2">
                <StackPanel.RenderTransform>
                  <!-- 分组切换过渡：旧内容淡出下移、新内容淡入上移（对齐原型 .fav-items is-leaving/is-entering） -->
                  <TranslateTransform x:ConnectionId='209' x:Name="FavItemsShift"/>
                </StackPanel.RenderTransform>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>

      <!-- 底栏（对齐原型 .footer：chips） -->
      <Grid x:ConnectionId='202' x:Name="FooterBar" Grid.Row="4" Padding="14,8,14,10" Background="{StaticResource FooterBgBrush}"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Background="{StaticResource ChipBgBrush}" CornerRadius="6" Padding="8,3">
            <TextBlock Text="Enter 打开" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
          </Border>
          <Border Background="{StaticResource ChipBgBrush}" CornerRadius="6" Padding="8,3">
            <TextBlock Text="Tab 动作" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
          </Border>
          <Border Background="{StaticResource ChipBgBrush}" CornerRadius="6" Padding="8,3">
            <TextBlock Text="Ctrl+, 设置" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
          </Border>
        </StackPanel>
        <TextBlock x:ConnectionId='203' x:Name="Footer" Text="本地 · 极速" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Grid>

    <!-- ========== 设置模式（同一主窗内切换，对齐原型 mode-settings） ========== -->
    <Grid x:ConnectionId='71' x:Name="SettingsPanel" Visibility="Collapsed" Background="Transparent"
                                      RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <!-- 模式切换过渡：设置页右滑淡出 / 从右滑入（对齐原型 mode-leave-right / mode-enter-from-right） -->
        <TransformGroup>
          <TranslateTransform x:ConnectionId='86' x:Name="SetShift"/>
          <ScaleTransform x:ConnectionId='87' x:Name="SetScale"/>
        </TransformGroup>
      </Grid.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 顶栏：返回 + 居中标题 -->
      <Grid Padding="14,12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="48"/>
        </Grid.ColumnDefinitions>
        <Button x:ConnectionId='196'                         Background="{StaticResource ChipBgBrush}"
                BorderThickness="0" CornerRadius="8" Padding="10,6">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Data="M 10 3 L 5 8 L 10 13" Stroke="{StaticResource TextSecondaryBrush}"
                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="16" Height="16"/>
            <TextBlock Text="返回" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1" Text="设置" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>

      <!-- 左侧导航 + 右侧 pane -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0" Padding="10,8">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="2">
              <!-- 导航项：图标 + 文字（对齐原生设置页左侧导航的常见形态）；选中态由 ShowPane 统一驱动 -->
              <Button x:ConnectionId='186' x:Name="NavGeneral" Tag="general" Style="{StaticResource NavItemStyle}"                      >
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon x:ConnectionId='195' x:Name="NavIconGeneral" Glyph="&#xE8FD;" FontSize="14"/>
                  <TextBlock Text="通用"/>
                </StackPanel>
              </Button>
              <Button x:ConnectionId='187' x:Name="NavAppearance" Tag="appearance" Style="{StaticResource NavItemStyle}"                      >
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon x:ConnectionId='194' x:Name="NavIconAppearance" Glyph="&#xE790;" FontSize="14"/>
                  <TextBlock Text="外观"/>
                </StackPanel>
              </Button>
              <Button x:ConnectionId='188' x:Name="NavBuiltins" Tag="builtins" Style="{StaticResource NavItemStyle}"                      >
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon x:ConnectionId='193' x:Name="NavIconBuiltins" Glyph="&#xE945;" FontSize="14"/>
                  <TextBlock Text="命令"/>
                </StackPanel>
              </Button>
              <Button x:ConnectionId='189' x:Name="NavPlugins" Tag="plugins" Style="{StaticResource NavItemStyle}"                      >
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon x:ConnectionId='192' x:Name="NavIconPlugins" Glyph="&#xE712;" FontSize="14"/>
                  <TextBlock Text="插件"/>
                </StackPanel>
              </Button>
              <Button x:ConnectionId='190' x:Name="NavAbout" Tag="about" Style="{StaticResource NavItemStyle}"                      >
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon x:ConnectionId='191' x:Name="NavIconAbout" Glyph="&#xE946;" FontSize="14"/>
                  <TextBlock Text="关于"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="20,12,16,16">
          <StackPanel>

            <!-- 通用 -->
            <StackPanel x:ConnectionId='88' x:Name="PaneGeneral" RenderTransformOrigin="0.5,0.5">
              <StackPanel.RenderTransform>
                <!-- pane 切换过渡：内容淡出上移 / 从下方淡入升起 -->
                <TranslateTransform x:ConnectionId='180' x:Name="PaneGeneralShift"/>
              </StackPanel.RenderTransform>
              <Border Style="{StaticResource PaneRowBorder}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="3">
                    <TextBlock Text="开机启动" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="随 Windows 登录自动启动" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                  </StackPanel>
                  <ToggleButton x:ConnectionId='185' x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource SwitchStyle}"                                                      />
                </Grid>
              </Border>
              <!-- 失焦隐藏 / 执行后隐藏为固化默认行为，不提供开关 -->
              <Border Style="{StaticResource PaneRowBorder}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="3">
                    <TextBlock Text="唤起热键" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="触发主窗口显示/隐藏的组合键（默认 Alt+Space）" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:ConnectionId='183' x:Name="BtnHotkeyAlt" Content="Alt + Space" Tag="Alt+Space"
                                                   Style="{StaticResource PresetStyle}"/>
                    <Button x:ConnectionId='184' x:Name="BtnHotkeyCtrl" Content="Ctrl + Space" Tag="Ctrl+Space"
                                                   Style="{StaticResource PresetStyle}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource PaneRowBorder}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="3">
                    <TextBlock Text="悬浮球" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="桌面边缘常驻悬浮球，点击唤起/隐藏主窗口（可拖拽贴边）" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                  </StackPanel>
                  <ToggleButton x:ConnectionId='182' x:Name="BallSwitch" Grid.Column="1" Style="{StaticResource SwitchStyle}"                                                />
                </Grid>
              </Border>
              <Border Style="{StaticResource PaneRowBorder}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="3">
                    <TextBlock Text="开发者模式" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="开启后插件页显示调试按钮，可用 DevTools 调试插件" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                  </StackPanel>
                  <ToggleButton x:ConnectionId='181' x:Name="DevModeSwitch" Grid.Column="1" Style="{StaticResource SwitchStyle}"                                                      />
                </Grid>
              </Border>
            </StackPanel>

            <!-- 外观 -->
            <StackPanel x:ConnectionId='89' x:Name="PaneAppearance" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
              <StackPanel.RenderTransform>
                <TranslateTransform x:ConnectionId='177' x:Name="PaneAppearanceShift"/>
              </StackPanel.RenderTransform>
              <Border Style="{StaticResource PaneRowBorder}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="主题" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <ComboBox x:ConnectionId='179' x:Name="ThemeCombo" Grid.Column="1" MinWidth="160" Style="{StaticResource ComboStyle}"
                                                             >
                    <ComboBoxItem Content="跟随系统"/>
                    <ComboBoxItem Content="深色玻璃"/>
                    <ComboBoxItem Content="浅色玻璃"/>
                  </ComboBox>
                </Grid>
              </Border>
              <Border Style="{StaticResource PaneRowBorder}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="默认视图" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <ComboBox x:ConnectionId='178' x:Name="ViewCombo" Grid.Column="1" MinWidth="160" Style="{StaticResource ComboStyle}"
                                                            >
                    <ComboBoxItem Content="列表"/>
                    <ComboBoxItem Content="平铺"/>
                  </ComboBox>
                </Grid>
              </Border>
            </StackPanel>

            <!-- 命令 -->
            <StackPanel x:ConnectionId='90' x:Name="PaneBuiltins" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
              <StackPanel.RenderTransform>
                <TranslateTransform x:ConnectionId='171' x:Name="PaneBuiltinsShift"/>
              </StackPanel.RenderTransform>
              <!-- 筛选行：关键词（名称/别名/拼音缩写/说明/id）；仅客户端内存过滤，随清单拉取结果显示 -->
              <TextBox x:ConnectionId='172' x:Name="BuiltinFilterBox" PlaceholderText="筛选：名称 / 拼音缩写（calc、jt）"
                       FontSize="12" Padding="8,8" CornerRadius="8" VerticalAlignment="Center"
                       BorderBrush="{StaticResource GlassBorderBrush}"
                       Foreground="{StaticResource TextPrimaryBrush}" Visibility="Collapsed"
                                                           />
              <ListView x:ConnectionId='173' x:Name="BuiltinList" SelectionMode="None" IsItemClickEnabled="False"
                        Margin="0,10,0,0"
                        Padding="0" Background="Transparent" BorderThickness="0">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="-12,0"/>
                    <Setter Property="CornerRadius" Value="12"/>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnSpacing="12" Padding="12,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <!-- 图标：系统图标优先（异步补齐，直接裸露无底衬），字形兜底 -->
                      <Grid Width="36" Height="36" VerticalAlignment="Center">
                        <Image Source="{Binding IconImage}" Width="36" Height="36" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IconImageVisibility}"/>
                        <Border CornerRadius="9" Background="{Binding IconBrush}"
                                Visibility="{Binding IconTextVisibility}">
                          <TextBlock Text="{Binding IconGlyph}" FontFamily="{Binding IconFont}"
                                     FontSize="{Binding IconFontSize}" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </Grid>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                          <Border Background="#33FF9F0A" CornerRadius="4" Padding="5,1"
                                  Visibility="{Binding ConfirmVisibility}" VerticalAlignment="Center">
                            <TextBlock Text="需确认" FontSize="9" Foreground="#FFFF9F0A"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <ItemsControl Grid.Column="2" ItemsSource="{Binding Aliases}"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{StaticResource ChipBgBrush}" CornerRadius="4" Padding="6,2">
                              <TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <!-- 有清单但筛选后为空（与"host 不可达时列表空白"自然区分） -->
              <TextBlock x:ConnectionId='174' x:Name="BuiltinFilterEmpty" Text="没有符合筛选条件的命令" FontSize="12"
                         Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                         Margin="0,24,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- 插件 -->
            <StackPanel x:ConnectionId='91' x:Name="PanePlugins" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
              <StackPanel.RenderTransform>
                <TranslateTransform x:ConnectionId='101' x:Name="PanePluginsShift"/>
              </StackPanel.RenderTransform>

              <!-- 顶部 Tab：已安装 / 插件市场 -->
              <Border Background="{StaticResource ChipBgBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                      BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,12" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:ConnectionId='168' x:Name="TabInstalledPluginsBtn" Content="已安装插件"                                    
                          Padding="14,6" CornerRadius="8" FontSize="12" FontWeight="SemiBold"
                          Background="{StaticResource AccentSoftBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                          BorderThickness="0"/>
                  <!-- 插件安全页（严格模式/受信任开发者）暂不开放：仅隐藏入口，功能与验签逻辑保持原样 -->
                  <Button x:ConnectionId='169' x:Name="TabPluginSecurityBtn" Content="插件安全"                                  
                          Padding="14,6" CornerRadius="8" FontSize="12"
                          Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                          BorderThickness="0" Visibility="Collapsed"/>
                  <Button x:ConnectionId='170' x:Name="TabMarketplaceBtn" Content="插件市场"                               
                          Padding="14,6" CornerRadius="8" FontSize="12"
                          Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                          BorderThickness="0"/>
                </StackPanel>
              </Border>

              <!-- 子面板 1：已安装插件管理 -->
              <StackPanel x:ConnectionId='102' x:Name="SubPaneInstalledPlugins" Visibility="Visible"
                          RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                  <TranslateTransform x:ConnectionId='141' x:Name="SubPaneInstalledPluginsShift"/>
                </StackPanel.RenderTransform>
                <!-- 顶部操作区：工具栏卡片，收拢 安装/开发目录/刷新 + 插件目录 -->
                <Border Background="{StaticResource ChipBgBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14,12">
                  <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button x:ConnectionId='163'                         Padding="10,6"
                              Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                              BorderThickness="1" CornerRadius="8" FontSize="12"
                              Foreground="{StaticResource TextPrimaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                          <TextBlock Text="安装本地插件"/>
                        </StackPanel>
                      </Button>
                      <!-- .spark-plugin（zip 根目录即插件文件）：UI 侧安全解压（同市场
                           Zip Slip/配额校验）后复用 host.plugin.install（规范 §3 安装方式） -->
                      <Button x:ConnectionId='164'                                  Padding="10,6"
                              Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                              BorderThickness="1" CornerRadius="8" FontSize="12"
                              Foreground="{StaticResource TextPrimaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <FontIcon Glyph="&#xE8B5;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                          <TextBlock Text="安装 .spark-plugin"/>
                        </StackPanel>
                      </Button>
                      <Grid x:ConnectionId='165' x:Name="DevLoadPluginWrap" Background="Transparent">
                        <Button x:ConnectionId='167' x:Name="DevLoadPluginBtn"                         Padding="10,6"
                                Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="1" CornerRadius="8" FontSize="12"
                                Foreground="{StaticResource TextPrimaryBrush}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8DA;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="加载开发目录"/>
                          </StackPanel>
                        </Button>
                      </Grid>
                      <Button x:ConnectionId='166'                          Padding="10,6"
                              Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                              BorderThickness="1" CornerRadius="8" FontSize="12"
                              Foreground="{StaticResource TextPrimaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                          <TextBlock Text="刷新"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="插件目录" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:ConnectionId='162' x:Name="PluginDirText" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                      </StackPanel>
                      <Grid x:ConnectionId='160' x:Name="ChangePluginDirWrap" Grid.Column="1" Background="Transparent">
                        <Button x:ConnectionId='161' x:Name="ChangePluginDirBtn" Content="更换…"                           Padding="10,5"
                                Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="1" CornerRadius="8" FontSize="12"
                                Foreground="{StaticResource TextPrimaryBrush}"/>
                      </Grid>
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock x:ConnectionId='142' x:Name="PluginStatus" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="18"
                           Visibility="Collapsed"/>

                <!-- 空态：没有任何插件时替代列表 -->
                <Grid x:ConnectionId='143' x:Name="PluginEmpty" MinHeight="320" Visibility="Collapsed">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                    <FontIcon Glyph="&#xE712;" FontSize="26"
                              Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="暂无插件" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="用上面的按钮安装插件包，或加载本地开发目录" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>

                <ListView x:ConnectionId='144' x:Name="PluginList" SelectionMode="None" IsItemClickEnabled="False"
                          Padding="0" Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                                                                         >
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="0,0,0,8"/>
                      <!-- 容器不获焦，焦点落在内部按钮/ToggleSwitch/CheckBox（自带系统焦点视觉） -->
                      <Setter Property="IsTabStop" Value="False"/>
                      <Setter Property="UseSystemFocusVisuals" Value="True"/>
                      <!-- 去掉默认 ListViewItemPresenter 的方角 hover/选中背景，只保留 DataTemplate 内的圆角卡片；
                           ContentPresenter 显式绑定容器的内容对齐与边距，确保 Stretch 可靠撑满 -->
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource ChipBgBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                              BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <StackPanel Spacing="0">
                          <!-- 标题行：图标 + 名称/角标（左）+ 展开按钮 + 开关（右） -->
                          <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 图标 -->
                            <Grid Width="34" Height="34" VerticalAlignment="Center">
                              <Image Source="{Binding IconImage}" Width="34" Height="34" Stretch="Uniform"
                                     Visibility="{Binding IconImageVisibility}"/>
                              <Border CornerRadius="9" Background="{StaticResource ChipBgBrush}"
                                      Visibility="{Binding IconTextVisibility}">
                                <TextBlock Text="{Binding IconLetter}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                            </Grid>

                            <!-- 名称 + 版本 + 角标 + 一句话描述 -->
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock Text="{Binding Version}" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                                <Border Background="#3330D158" CornerRadius="4" Padding="5,1"
                                        Visibility="{Binding DevBadgeVisibility}" VerticalAlignment="Center">
                                  <TextBlock Text="开发" FontSize="9" Foreground="#FF30D158"/>
                                </Border>
                                <Border Background="{Binding SignBadgeBackground}" CornerRadius="4" Padding="5,1"
                                        Visibility="{Binding SignBadgeVisibility}" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding SignBadgeText}" FontSize="9"
                                             Foreground="{Binding SignBadgeForeground}"/>
                                </Border>
                              </StackPanel>
                              <TextBlock Text="{Binding Description}" FontSize="11"
                                         Foreground="{StaticResource TextTertiaryBrush}"
                                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>

                            <!-- 右侧：展开切换 + 开关（与通用页同款 ToggleButton + SwitchStyle，无 hover 缩放） -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                              <Button x:ConnectionId='157'                              Padding="6,5"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource TextSecondaryBrush}">
                                <FontIcon Glyph="&#xE70D;" FontSize="11"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          RenderTransformOrigin="0.5,0.5">
                                  <FontIcon.RenderTransform>
                                    <RotateTransform x:Name="ExpandArrowRotate" Angle="0"/>
                                  </FontIcon.RenderTransform>
                                </FontIcon>
                              </Button>
                              <ToggleButton x:ConnectionId='158' IsChecked="{Binding Enabled, Mode=TwoWay}"
                                            Style="{StaticResource SwitchStyle}"
                                                                                                 />
                            </StackPanel>
                          </Grid>

                          <!-- 详情区：展开后显示。左右缩进 2px 与标题区对齐，分隔线收窄留呼吸。
                               展开过渡由 OnTogglePluginExpand 驱动 Opacity+位移；Visibility 仍由绑定瞬时控制。 -->
                          <StackPanel x:Name="PluginDetailPanel" Spacing="10" Margin="2,12,2,0"
                                      Visibility="{Binding DetailVisibility}" Opacity="0"
                                      RenderTransformOrigin="0.5,0">
                            <StackPanel.RenderTransform>
                              <TranslateTransform x:Name="PluginDetailShift"/>
                            </StackPanel.RenderTransform>
                            <Border Background="{StaticResource DividerBrush}" Height="1" Opacity="0.4"
                                    Margin="-2,0"/>

                            <!-- 签名失效提示 -->
                            <TextBlock Text="签名校验失败（文件可能被篡改），建议停用或卸载" FontSize="10"
                                       Foreground="#FFFF453A"
                                       Visibility="{Binding InvalidHintVisibility}"/>

                            <!-- 触发关键字 -->
                            <ItemsControl ItemsSource="{Binding Keywords}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal" Spacing="4"/>
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Background="{StaticResource ChipBgBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                                          BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding}" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 权限授权 -->
                            <ItemsControl ItemsSource="{Binding Permissions}"
                                          Visibility="{Binding PermissionsVisibility}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal" Spacing="10"/>
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <CheckBox x:ConnectionId='154' Content="{Binding Display}" IsChecked="{Binding Granted, Mode=TwoWay}"
                                              ToolTipService.ToolTip="{Binding Description}"
                                              MinWidth="0" FontSize="11"                              
                                                                             
                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Button x:ConnectionId='155'                       Content="{Binding FsScopeSummary}"
                                            Visibility="{Binding FsScopeButtonVisibility}"
                                            ToolTipService.ToolTip="编辑插件可访问的目录范围（fs 权限授权时定范围）"
                                            Padding="6,2" FontSize="10" MinWidth="0" MinHeight="0"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource GlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="6"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 操作按钮 -->
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                              <Button x:ConnectionId='150'                          Padding="12,5" FontSize="11"
                                      Visibility="{Binding OpenVisibility}"
                                      Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                                      BorderThickness="1" CornerRadius="8" Foreground="{StaticResource AccentBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                  <TextBlock Text="打开" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                              </Button>
                              <Button x:ConnectionId='151'                       Padding="12,5" FontSize="11"
                                      Visibility="{Binding DebugVisibility}"
                                      Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                                      BorderThickness="1" CornerRadius="8" Foreground="{StaticResource AccentBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <FontIcon Glyph="&#xEB1F;" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                  <TextBlock Text="调试" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                              </Button>
                              <Button x:ConnectionId='152'                           Padding="12,5" FontSize="11"
                                      Visibility="{Binding UninstallVisibility}"
                                      Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                                      BorderThickness="1" CornerRadius="8" Foreground="{StaticResource TextSecondaryBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                  <TextBlock Text="卸载" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                              </Button>
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </StackPanel>

              <!-- 子面板 1b：插件安全（严格模式 + 受信任开发者，从已安装面板抽出独立展示） -->
              <StackPanel x:ConnectionId='103' x:Name="SubPanePluginSecurity" Visibility="Collapsed" Spacing="10"
                          RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                  <TranslateTransform x:ConnectionId='132' x:Name="SubPanePluginSecurityShift"/>
                </StackPanel.RenderTransform>
                <!-- 签名安全：严格模式 + 受信任开发者（3.2/3.3） -->
                <Border Background="{StaticResource ChipBgBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14,12">
                  <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Spacing="3">
                        <TextBlock Text="严格模式" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="开启后仅安装带有效签名的插件（官方或已信任的三方），无签名插件拒装。默认关闭。" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                      </StackPanel>
                      <ToggleButton x:ConnectionId='140' x:Name="StrictModeSwitch" Grid.Column="1" VerticalAlignment="Center"
                                    Style="{StaticResource SwitchStyle}"                                                            />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- 受信任开发者（3.3）：导入三方公钥，其签名的插件显"已签名"角标 -->
                <Border Background="{StaticResource ChipBgBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,10,0,0">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="3">
                      <TextBlock Text="受信任开发者" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                      <TextBlock Text="导入第三方开发者的 Ed25519 公钥后，其签名的插件将显示&quot;已签名&quot;角标（不会变成&quot;官方&quot;）。" FontSize="11"
                                 Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>

                    <!-- 已导入的公钥列表 -->
                    <ItemsControl x:ConnectionId='133' x:Name="TrustedDevList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{StaticResource ChipBgBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                                  BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                            <Grid ColumnSpacing="8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KeyId}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PublicKeyPreview}" FontSize="10"
                                           Foreground="{StaticResource TextTertiaryBrush}" FontFamily="Consolas"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Note}" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                              <Button x:ConnectionId='139' Grid.Column="1"                            Padding="8,4"
                                      Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                                      BorderThickness="1" CornerRadius="6" FontSize="11"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                              </Button>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 添加新公钥：key_id + base64 公钥 + 添加按钮 -->
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBox x:ConnectionId='135' x:Name="TrustedDevKeyId" PlaceholderText="key_id" Width="140"
                               FontSize="12" Padding="8,8" CornerRadius="6"
                               BorderBrush="{StaticResource GlassBorderBrush}"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                      <TextBox x:ConnectionId='136' x:Name="TrustedDevPubkey" Grid.Column="1" PlaceholderText="base64 公钥（32 字节 Ed25519）"
                               FontSize="12" Padding="8,8" CornerRadius="6"
                               BorderBrush="{StaticResource GlassBorderBrush}"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                      <Button x:ConnectionId='137' Grid.Column="2"                         Content="添加" Padding="12,5"
                              Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                              BorderThickness="1" CornerRadius="8" FontSize="12"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock x:ConnectionId='134' x:Name="TrustedDevStatus" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" LineHeight="16" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- 子面板 2：插件市场 -->
              <StackPanel x:ConnectionId='104' x:Name="SubPaneMarketplace" Visibility="Collapsed" Spacing="10"
                          RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                  <TranslateTransform x:ConnectionId='105' x:Name="SubPaneMarketplaceShift"/>
                </StackPanel.RenderTransform>
                <!-- 市场源选择与配置卡片 -->
                <Border Background="{StaticResource ChipBgBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14,12">
                  <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <ComboBox x:ConnectionId='129' x:Name="MarketSourceCombo" Style="{StaticResource ComboStyle}" ItemContainerStyle="{StaticResource ComboItemStyle}"
                                HorizontalAlignment="Stretch"                                         />
                      <Button x:ConnectionId='130' Grid.Column="1" x:Name="MarketCustomManageBtn" Content="管理仓库…"                                  
                              Padding="10,6" Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                              BorderThickness="1" CornerRadius="8" FontSize="12"
                              Foreground="{StaticResource TextPrimaryBrush}"/>
                      <Button x:ConnectionId='131' Grid.Column="2" x:Name="MarketRefreshBtn"                         Padding="10,6"
                              Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                              BorderThickness="1" CornerRadius="8" FontSize="12"
                              Foreground="{StaticResource TextPrimaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                          <TextBlock Text="刷新"/>
                        </StackPanel>
                      </Button>
                    </Grid>

                    <!-- 自定义仓库管理展开区 -->
                    <StackPanel x:ConnectionId='122' x:Name="MarketCustomReposPanel" Visibility="Collapsed" Spacing="8" Margin="0,4,0,0">
                      <TextBlock Text="自定义仓库列表 (URL)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                      <ItemsControl x:ConnectionId='124' x:Name="MarketCustomUrlList">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnSpacing="8" Margin="0,0,0,6">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <!-- 小字号 + 默认 Padding 内容不足 MinHeight=32，文本会顶对齐；MinHeight=0 收紧自适配即居中 -->
                              <TextBox Text="{Binding Url, Mode=TwoWay}" FontSize="11" VerticalAlignment="Center" MinHeight="0"/>
                              <Button x:ConnectionId='128' Grid.Column="1"                               Padding="8,4"
                                      Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                                      BorderThickness="1" CornerRadius="6" FontSize="11"
                                      Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:ConnectionId='125' Content="＋ 添加仓库"                            Padding="10,5"
                                Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="1" CornerRadius="8" FontSize="11"
                                Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Button x:ConnectionId='126' Content="保存更改"                              Padding="12,5"
                                Background="{StaticResource AccentSoftBrush}" BorderThickness="0"
                                CornerRadius="8" FontSize="11" FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- 第三方仓库安全提示 -->
                    <Border x:ConnectionId='123' x:Name="MarketCustomWarning" Background="#26FF9F0A" BorderBrush="#66FF9F0A"
                            BorderThickness="1" CornerRadius="8" Padding="10,8" Visibility="Collapsed">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#FFFF9F0A" VerticalAlignment="Center"/>
                        <TextBlock Text="你正在连接第三方仓库，插件安全性由仓库维护者负责，请谨慎安装高权限插件。"
                                   FontSize="11" Foreground="#FFFF9F0A" TextWrapping="Wrap" LineHeight="16"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- 筛选行：关键词（名称/描述/作者/id）+ 安装与签名状态；仅客户端内存过滤，随加载结果显隐 -->
                <Grid x:ConnectionId='106' x:Name="MarketFilterRow" ColumnSpacing="8" Visibility="Collapsed">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:ConnectionId='120' x:Name="MarketFilterBox" PlaceholderText="筛选：名称 / 描述 / 作者 / id"
                           FontSize="12" Padding="8,8" CornerRadius="8" VerticalAlignment="Center"
                           BorderBrush="{StaticResource GlassBorderBrush}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                                                              />
                  <ComboBox x:ConnectionId='121' x:Name="MarketFilterCombo" Grid.Column="1" Style="{StaticResource ComboStyle}"
                            ItemContainerStyle="{StaticResource ComboItemStyle}" MinWidth="104"
                            VerticalAlignment="Center"                                         >
                    <!-- 初选在代码后置设（构造函数）：WinUI 解析期 IsSelected="True" 会同步触发 SelectionChanged -->
                    <ComboBoxItem Content="全部"/>
                    <ComboBoxItem Content="未安装"/>
                    <ComboBoxItem Content="已安装"/>
                    <ComboBoxItem Content="官方"/>
                    <ComboBoxItem Content="已签名"/>
                    <ComboBoxItem Content="待签名"/>
                    <ComboBoxItem Content="签名失效"/>
                    <ComboBoxItem Content="可更新"/>
                  </ComboBox>
                </Grid>

                <!-- 更新检查结果（打开市场页即与索引比对版本，无需手动刷新）：
                     有可更新插件时显形并提供「全部更新」批量入口 -->
                <Border x:ConnectionId='107' x:Name="MarketUpdateNotice" Visibility="Collapsed"
                        Background="#260A84FF" BorderBrush="#660A84FF" BorderThickness="1"
                        CornerRadius="8" Padding="10,8">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE895;" FontSize="13" Foreground="{StaticResource AccentBrush}"
                                VerticalAlignment="Center"/>
                      <TextBlock x:ConnectionId='119' x:Name="MarketUpdateNoticeText" FontSize="11"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 TextWrapping="Wrap" LineHeight="16" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:ConnectionId='118' x:Name="MarketUpdateAllBtn" Grid.Column="1" Content="全部更新"
                                                      Padding="10,4" CornerRadius="8"
                            BorderThickness="0" FontSize="11" FontWeight="SemiBold"
                            Background="{StaticResource AccentSoftBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>

                <!-- 分类标签栏（规范 §3.3 tags）：点击按分类筛选（「全部」清空）。
                     一个插件可归多个分类，故此处按"任一标签命中"筛选；列表分组则按
                     首个标签归组（PrimaryTag），避免同一插件在多组里重复出现。
                     无任何标签数据时整条隐藏，不占版面。 -->
                <ScrollViewer x:ConnectionId='108' x:Name="MarketTagScroll" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Auto" VerticalScrollMode="Disabled"
                              Margin="0,2,0,0">
                  <ItemsControl x:ConnectionId='116' x:Name="MarketTagBar">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button x:ConnectionId='117' Content="{Binding Label}"                         
                                Padding="10,4" CornerRadius="12" BorderThickness="1" FontSize="11"
                                Background="{Binding ChipBackground}"
                                BorderBrush="{Binding ChipBorderBrush}"
                                Foreground="{Binding ChipForeground}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <!-- 市场状态提示 / 加载中 -->
                <StackPanel x:ConnectionId='109' x:Name="MarketLoadingWrap" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Center" Margin="0,16,0,8" Visibility="Collapsed">
                  <ProgressRing Width="20" Height="20" IsActive="True"/>
                  <TextBlock Text="正在连接插件仓库…" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:ConnectionId='110' x:Name="MarketStatusText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18"
                           Visibility="Collapsed"/>

                <!-- 市场空态 -->
                <Grid x:ConnectionId='111' x:Name="MarketEmpty" MinHeight="260" Visibility="Collapsed">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                    <FontIcon Glyph="&#xE719;" FontSize="28"
                              Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="仓库暂无可用插件" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="请检查网络或切换到其他仓库源" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>

                <!-- 有数据但筛选后为空（与"仓库空态"区分，文案更精确） -->
                <TextBlock x:ConnectionId='112' x:Name="MarketFilterEmpty" Text="没有符合筛选条件的插件" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                           Margin="0,24,0,0" Visibility="Collapsed"/>

                <!-- 市场插件列表（卡片样式与已装插件列表同款：34px 首字母图标 + 标题行 + 元信息行） -->
                <ListView x:ConnectionId='113' x:Name="MarketList" SelectionMode="None" IsItemClickEnabled="False"
                          Padding="0" Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                          ItemTemplateSelector="{StaticResource MarketRowSelector}">
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0"/>
                      <!-- 行距由两套行模板各自给（分组头 10px / 卡片 8px），容器不再统一加下边距 -->
                      <Setter Property="Margin" Value="0"/>
                      <Setter Property="IsTabStop" Value="False"/>
                      <Setter Property="UseSystemFocusVisuals" Value="True"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListViewItem">
                            <!-- ContentTemplateSelector 必须一起转发：ItemTemplateSelector 选中的
                                 模板是通过容器的 ContentTemplateSelector 下发的，漏转发会整列空白 -->
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListView.ItemContainerStyle>
                </ListView>
              </StackPanel>
            </StackPanel>

            <!-- 关于 -->
            <StackPanel x:ConnectionId='92' x:Name="PaneAbout" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
              <StackPanel.RenderTransform>
                <TranslateTransform x:ConnectionId='93' x:Name="PaneAboutShift"/>
              </StackPanel.RenderTransform>
              <!-- 内容整体垂直居中：MinHeight 撑满可视区，避免头重脚轻 -->
              <Grid MinHeight="480">
                <StackPanel VerticalAlignment="Center">

              <!-- 应用信息（紧凑 hero） -->
              <StackPanel HorizontalAlignment="Center" Spacing="0" Margin="0,6,0,0">
                <Border Width="60" Height="60" CornerRadius="15" Padding="6"
                        Background="{StaticResource ChipBgBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1" HorizontalAlignment="Center">
                  <Image Source="Assets/spark.png" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="Spark" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock x:ConnectionId='100' x:Name="AboutVersionText" FontSize="12"
                           Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>

              <!-- 简介 -->
              <TextBlock Text="本地优先的极速启动器：搜索应用、文件与命令，支持插件扩展。"
                         FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                         TextWrapping="Wrap" TextAlignment="Center" LineHeight="18"
                         MaxWidth="340" HorizontalAlignment="Center" Margin="0,18,0,0"/>

              <!-- 检查更新 + 仓库地址（一行两个轻量链接） -->
              <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                  <Button x:ConnectionId='96' x:Name="BtnCheckUpdate"                       Background="Transparent" BorderThickness="0"
                          Padding="6,3" CornerRadius="6" FontSize="12" Foreground="{StaticResource AccentBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                      <TextBlock x:ConnectionId='99' x:Name="CheckUpdateLabel" Text="检查更新" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                  </Button>
                  <Button x:ConnectionId='97' x:Name="BtnOpenRelease" Content="打开下载页"                      
                          Background="Transparent" BorderThickness="0" Padding="6,3" CornerRadius="6"
                          FontSize="12" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                  <TextBlock Text="·" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <Button x:ConnectionId='98' Content="GitHub 仓库"                      Background="Transparent" BorderThickness="0"
                          Padding="6,3" CornerRadius="6" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
                <TextBlock x:ConnectionId='94' x:Name="AboutUpdateStatus" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"/>
                <ProgressBar x:ConnectionId='95' x:Name="UpdateProgress" Width="240" Height="4" Minimum="0" Maximum="100"
                             Value="0" Visibility="Collapsed" Margin="0,10,0,0"/>
              </StackPanel>

              <!-- 技术栈 -->
              <TextBlock Text="Rust + WinUI 3 · MIT License" FontSize="12"
                         Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>

                </StackPanel>
              </Grid>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ========== 新建分组（窗口内模态，对齐应用玻璃风格；系统 ContentDialog 样式与整体不搭） ========== -->
    <Grid x:ConnectionId='72' x:Name="FavGroupPanel" Visibility="Collapsed" Background="#66000000"
                                        >
      <Border x:ConnectionId='80' x:Name="FavGroupCard" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource ModalCardBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
              CornerRadius="14" Padding="18,16"                              >
        <Border.RenderTransform>
          <!-- 入场动画：淡入 + 上浮放大（与窗口 pop-in 同款曲线，减少动画时跳过） -->
          <TransformGroup>
            <TranslateTransform x:ConnectionId='81' x:Name="FavGroupCardShift"/>
            <ScaleTransform x:ConnectionId='82' x:Name="FavGroupCardScale"/>
          </TransformGroup>
        </Border.RenderTransform>
        <StackPanel Spacing="14">
          <TextBlock Text="新建分组" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"/>
          <TextBox x:ConnectionId='83' x:Name="FavGroupName" FontSize="13" MaxLength="8"
                   PlaceholderText="分组名称（最多 8 字）"
                   Background="{StaticResource ChipBgBrush}"
                   BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                   CornerRadius="8" Padding="10,7"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   PlaceholderForeground="{StaticResource TextTertiaryBrush}"
                                                  />
          <Grid ColumnSpacing="8" HorizontalAlignment="Right">
            <Button x:ConnectionId='84' Content="取消"                         
                    Background="{StaticResource ChipBgBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,5" FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"/>
            <Button x:ConnectionId='85' Grid.Column="1" Content="创建"                         
                    Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource RowActiveBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,5" FontSize="12"
                    FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ========== 删除分组确认（窗口内模态，复用新建分组面板样式；「全部」分组不可删） ========== -->
    <Grid x:ConnectionId='73' x:Name="FavConfirmPanel" Visibility="Collapsed" Background="#66000000"
                                                                        >
      <Border x:ConnectionId='74' x:Name="FavConfirmCard" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource ModalCardBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
              CornerRadius="14" Padding="18,16"                                >
        <Border.RenderTransform>
          <TransformGroup>
            <TranslateTransform x:ConnectionId='75' x:Name="FavConfirmCardShift"/>
            <ScaleTransform x:ConnectionId='76' x:Name="FavConfirmCardScale"/>
          </TransformGroup>
        </Border.RenderTransform>
        <StackPanel Spacing="14">
          <TextBlock Text="删除分组" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"/>
          <TextBlock x:ConnectionId='77' x:Name="FavConfirmMsg" FontSize="12" TextWrapping="Wrap"
                     Foreground="{StaticResource TextSecondaryBrush}"/>
          <Grid ColumnSpacing="8" HorizontalAlignment="Right">
            <Button x:ConnectionId='78' x:Name="FavConfirmCancelBtn" Content="取消"                           
                    Background="{StaticResource ChipBgBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,5" FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"/>
            <Button x:ConnectionId='79' Grid.Column="1" Content="删除"                           
                    Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,5" FontSize="12"
                    FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 顶部高光（对应 .launcher-glass::before，置于最上避免被设置层盖住） -->
      <Border IsHitTestVisible="False" CornerRadius="{StaticResource WinCornerRadius}">
        <Border.Background>
          <StaticResource ResourceKey="GlassHighlightBrush"/>
        </Border.Background>
      </Border>
    </Grid>

    <!-- 玻璃描边（对齐原型 launcher-glass 1px 边框）：CornerRadius 与 DWM/ContentClip 圆角一致，
         描边弧线正好落在窗口可见边缘内，四角不会断线 -->
    <Border IsHitTestVisible="False" CornerRadius="{StaticResource WinCornerRadius}"
            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"/>
  </Grid>
</Window>

