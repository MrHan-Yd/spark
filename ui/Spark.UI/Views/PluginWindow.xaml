<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Spark.UI.Views.PluginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

  <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 标题栏容器（36px）：frame=false 时由代码折叠。
         左侧 TitleBar（图标+名称）为 SetTitleBar 拖拽区；右侧按钮组在 TitleBar 之外，可正常点击。 -->
    <Grid x:Name="TitleBarHost" Grid.Row="0" Height="36"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- 拖拽区：仅图标+名称，SetTitleBar(TitleBar) 目标。按钮不在此元素内，不被 caption 吞。 -->
      <Grid x:Name="TitleBar" Grid.Column="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="TitleIcon" Grid.Column="0" Width="18" Height="18" Margin="12,4,0,4"
                Stretch="Uniform"/>
        <TextBlock x:Name="TitleText" Grid.Column="1" Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
      </Grid>

      <!-- 窗口控制按钮组：在 TitleBar 之外，保持客户区可点击。仅关闭 hover 红。 -->
      <StackPanel x:Name="CaptionButtons" Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="MinBtn" Click="OnMinClick"
                Width="36" Height="36" Padding="0"
                Background="Transparent" BorderThickness="0"
                FontSize="11"
                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                Content="&#xE921;"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                UseSystemFocusVisuals="False">
          <Button.Resources>
            <ResourceDictionary>
              <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF"/>
              <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24FFFFFF"/>
            </ResourceDictionary>
          </Button.Resources>
        </Button>
        <Button x:Name="MaxBtn" Click="OnMaxClick"
                Width="36" Height="36" Padding="0"
                Background="Transparent" BorderThickness="0"
                FontSize="11"
                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                Content="&#xE922;"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                UseSystemFocusVisuals="False">
          <Button.Resources>
            <ResourceDictionary>
              <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF"/>
              <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24FFFFFF"/>
            </ResourceDictionary>
          </Button.Resources>
        </Button>
        <Button x:Name="CloseBtn" Click="OnCloseClick"
                Width="36" Height="36" Padding="0"
                Background="Transparent" BorderThickness="0"
                FontSize="14"
                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                Content="&#xE8BB;"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                UseSystemFocusVisuals="False">
          <Button.Resources>
            <ResourceDictionary>
              <SolidColorBrush x:Key="ButtonBackgroundPointerOver">#C5FF453A</SolidColorBrush>
              <SolidColorBrush x:Key="ButtonForegroundPointerOver">#FFFFFFFF</SolidColorBrush>
              <SolidColorBrush x:Key="ButtonBackgroundPressed">#FFFF453A</SolidColorBrush>
              <SolidColorBrush x:Key="ButtonForegroundPressed">#FFFFFFFF</SolidColorBrush>
            </ResourceDictionary>
          </Button.Resources>
        </Button>
      </StackPanel>

      <!-- 底边分隔线 -->
      <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1"
              Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
              IsHitTestVisible="False"/>
    </Grid>

    <controls:WebView2 x:Name="Web" Grid.Row="1"/>
  </Grid>
</Window>