<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Spark.UI.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Padding="16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="QueryBox"
                PlaceholderText="搜索应用、文件、命令…"
                FontSize="18"
                TextChanged="QueryBox_TextChanged"
                KeyDown="QueryBox_KeyDown"/>
            <Button Grid.Column="1" Content="设置" Click="BtnSettings_Click" Padding="12,8"/>
        </Grid>

        <ListView
            x:Name="ResultsList"
            Grid.Row="1"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="ResultsList_ItemClick"
            Margin="8,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="8,10" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="FooterStatus"
            Grid.Row="2"
            Margin="16,8"
            FontSize="12"
            Opacity="0.6"
            Text="Enter 打开 · 离线演示数据"/>
    </Grid>
</UserControl>
